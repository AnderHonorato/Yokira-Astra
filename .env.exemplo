# Arquivo: .env.exemplo
# Copie para .env antes de rodar. Nunca versione o .env de verdade.
#
# Esta e a copia de trabalho `yokira-astra`. Os valores abaixo sao proprios dela: porta,
# banco, pastas de midia e nome de cookie nao batem com os do projeto original, de
# proposito. E o que permite rodar os dois ao mesmo tempo na mesma maquina sem que a
# sessao de um derrube a do outro.

# SQLite em desenvolvimento. Em producao troque pela URL do PostgreSQL.
DATABASE_URL="file:./dev.db"

# Segredo usado pra assinar os links de midia (playlists e segmentos HLS) e as sessoes.
# Em producao o servidor se recusa a servir midia com o valor de exemplo abaixo.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SEGREDO_SESSAO="troque-este-valor-por-uma-string-longa-e-aleatoria"

# Porta desta copia. Fixa de proposito: se estiver ocupada, o servidor falha em vez de
# pular para outra, e voce nunca fica em duvida sobre onde o projeto subiu.
PORT=4107
HOST=127.0.0.1
ORIGIN="http://localhost:4107"

# O nome do cookie de sessao NAO e variavel de ambiente: ele e a constante
# NOME_COOKIE_SESSAO em src/lib/servidor/autenticacao/sessao.ts, e vale
# "yokira_astra_sessao" nesta copia. Cookie nao e separado por porta — sem um nome
# proprio, entrar aqui derrubaria a sessao do projeto original em localhost. O mesmo vale
# para NOME_COOKIE_TEMA, em src/lib/validacoes/tema.ts.

# Pastas de midia (ficam fora do git)
PASTA_UPLOADS="./midia/originais"
PASTA_HLS="./midia/hls"
PASTA_CAPAS="./midia/capas"
PASTA_LEGENDAS="./midia/legendas"

# Teto real de upload, conferido enquanto os bytes sao gravados. O padrao sao 8 GB;
# ajuste para o disco de quem hospeda antes de prometer isso na tela.
# LIMITE_UPLOAD_BYTES=8589934592

# Caminho do binario do ffmpeg. Deixe "ffmpeg" se ja estiver no PATH.
# O ffprobe e procurado ao lado dele; aponte CAMINHO_FFPROBE so se estiver noutro lugar.
CAMINHO_FFMPEG="ffmpeg"
# CAMINHO_FFPROBE="ffprobe"

# Conversoes simultaneas (padrao 1, teto 4). O ffmpeg usa o processador inteiro: mais de
# uma ao mesmo tempo deixa o site lento para quem so quer assistir.
# CONVERSOES_SIMULTANEAS=1

# Com qualquer valor, o processo web NAO consome a fila de conversao. Use quando houver um
# processo separado so para converter.
# SEM_TRABALHADOR=1

# Envio de e-mail (verificacao de conta e recuperacao de senha).
# console = imprime a mensagem no terminal (padrao, otimo pra desenvolver)
# arquivo = grava uma linha JSON por mensagem em EMAIL_ARQUIVO
# resend  = envia de verdade pela API do Resend
EMAIL_TRANSPORTE="arquivo"
EMAIL_ARQUIVO="./midia/emails-locais.log"
EMAIL_REMETENTE="Yokira Astra <local@yokira.test>"
RESEND_API_KEY=""

# Conta de administrador criada pelo seed. `npm run contas:locais` reajusta a senha
# quando o banco veio de outro lugar e a senha do seed nao vale mais.
ADMIN_EMAIL="admin@yokira.local"
ADMIN_SENHA="YokiraAdmin#2024"
