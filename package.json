{
  "name": "yokira-astra",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Yokira Animes - plataforma de streaming de animes",
  "scripts": {
    "dev": "vite dev --port 4107 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4107 --strictPort",
    "iniciar": "tsx scripts/iniciar-servidor.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "formatar:checar": "prettier --check .",
    "teste:unitario": "vitest run",
    "teste:ponta": "playwright test",
    "teste:preparar": "prisma migrate deploy && tsx prisma/seed.ts",
    "verificar": "npm run typecheck && npm run lint && npm run formatar:checar && npm run teste:unitario",
    "banco:migrar": "prisma migrate dev",
    "banco:gerar": "prisma generate",
    "banco:semear": "tsx prisma/seed.ts",
    "contas:locais": "tsx scripts/criar-contas-locais.ts",
    "banco:reiniciar": "prisma migrate reset --force && npm run banco:semear",
    "encerrar": "tsx scripts/encerrar-servidor.ts",
    "postinstall": "svelte-kit sync && prisma generate",
    "preparar": "svelte-kit sync && prisma generate && prisma migrate deploy && npm run banco:semear",
    "iniciar:limpo": "npm run encerrar && npm run build && npm run iniciar",
    "banco:promover": "tsx scripts/promover-administrador.ts",
    "banco:exportar": "tsx scripts/exportar-banco.ts",
    "banco:importar": "tsx scripts/importar-banco.ts",
    "video:teste": "tsx scripts/gerar-video-teste.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prisma": "^7.9.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "hls.js": "^1.7.1"
  }
}
